# AgentFlow production environment.
#
#   cp deploy/compose/.env.prod.example deploy/compose/.env
#
# Fill the values below. Comment out what you do not use: an empty value fails
# validation for some optional fields. The compose file sets these itself, do not
# set them here: DATABASE_URL, S3_ENDPOINT, BETTER_AUTH_URL, AGENTFLOW_MCP_URL,
# AUTH_API_URL, LOCAL_GIT_TOKEN_FILE. Advanced: AGENTFLOW_ENV_FILE (path of the
# env file the api loads, default .env) and AGENTFLOW_IMAGE_NAMESPACE (image
# name prefix, default agentflow-prod).
#
# Optional services: COMPOSE_PROFILES=orchestrator,local-git,mailpit (or --profile flags).
# COMPOSE_PROFILES=orchestrator
#
# Marked "build-time": baked into an image, rebuild after changing
# (`up -d --build`). Marked "runtime": `up -d` recreates the containers.

# --- Public origins ---------------------------------------------------------
# build-time (app AND api)
NEXT_PUBLIC_APP_URL=https://agentflow.example.com
NEXT_PUBLIC_API_URL=https://api.agentflow.example.com
# Marketing/docs site, or the app origin if you have none.
NEXT_PUBLIC_WEB_URL=https://agentflow.example.com
# build-time (app)
# NEXT_PUBLIC_DOCS_URL=
# runtime
MCP_SERVER_URL=https://mcp.agentflow.example.com
# Browser-reachable S3 origin baked into presigned URLs.
S3_PUBLIC_ENDPOINT=https://s3.agentflow.example.com
# Defaults to the API origin.
# API_BASE_URL=
# PUBLIC_WEBHOOK_BASE_URL=

# --- Accounts (runtime) -----------------------------------------------------
# First AgentFlow owner, created by the `bootstrap-admin` job when no user
# exists yet (works with AUTH_ALLOW_SIGN_UP=false). Password: at least 8
# characters, openssl rand -base64 18. Later changes are made in the app.
AGENTFLOW_ADMIN_EMAIL=admin@example.com
AGENTFLOW_ADMIN_PASSWORD=
AGENTFLOW_ADMIN_NAME=Administrator

# --- Secrets (runtime) ------------------------------------------------------
# URL-safe, used inside DATABASE_URL: openssl rand -hex 32
POSTGRES_PASSWORD=
# S3 credentials for RustFS (also the RustFS console login): openssl rand -hex 16 / openssl rand -hex 32
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# openssl rand -base64 32
BETTER_AUTH_SECRET=
# openssl rand -base64 32. Losing it makes stored tokens unreadable: back it up.
ENCRYPTION_KEY=
# openssl rand -hex 32
INTERNAL_API_SECRET=
# Required (the api refuses to start without it). At least 32 characters, at
# least 8 different ones: openssl rand -hex 32
AGENTFLOW_RUNNER_JWT_SECRET=

# --- Postgres / S3 (runtime) -----------------------------------------------
# Change before the first `up`: the postgres volume keeps the first values.
POSTGRES_USER=postgres
POSTGRES_DB=agentflow_ai
S3_REGION=us-east-1
FILE_ATTACHMENTS_BUCKET=agentflow-attachments
TRANSCRIPTS_BUCKET=agentflow-transcripts
PLUGIN_STORE_BUCKET=agentflow-plugin-store
LOOP_STATE_BUCKET=agentflow-loop-state
# Defaults to NEXT_PUBLIC_APP_URL.
# S3_CORS_ALLOWED_ORIGINS=

# --- Mail (runtime) ---------------------------------------------------------
SMTP_URL=smtp://user:pass@mail.example.com:587
EMAIL_FROM="AgentFlow <no-reply@example.com>"

# --- Authentication (runtime) ----------------------------------------------
# false = invite-only: the app hides sign-up and opens on sign-in.
# AUTH_ALLOW_SIGN_UP=false
# true = signed-in users may create additional organizations.
# AUTH_ALLOW_CREATE_ORGANIZATION=true
# AUTH_DEFAULT_ORGANIZATION_NAME=AgentFlow
# AUTH_DEFAULT_ORGANIZATION_SLUG=agentflow
# Microsoft Entra ID SSO (read by the api). Redirect URI:
# <NEXT_PUBLIC_APP_URL>/api/auth/callback/microsoft
# AUTH_MICROSOFT_CLIENT_ID=
# AUTH_MICROSOFT_CLIENT_SECRET=
# AUTH_MICROSOFT_TENANT_ID=common
# Extra origins, comma-separated.
# BETTER_AUTH_TRUSTED_ORIGINS=

# --- Feature flags ----------------------------------------------------------
# runtime (api)
# AGENTFLOW_FEATURE_FLAGS=
# build-time (app)
# NEXT_PUBLIC_AGENTFLOW_FEATURE_FLAGS=

# --- Scheduler (runtime) ----------------------------------------------------
# WORKFLOW_TICK_SECONDS=10
# WORKFLOW_RUN_PHASE_TIMEOUT_HOURS=24
# SELF_HOSTED_CRON_DISABLED=true
# CRON_SECRET=

# --- Local Git (profile `local-git`, runtime) ------------------------------
# Admin user of Gitea, created/updated by the `local-git-init` job on every up.
# LOCAL_GIT_ADMIN_USER=agentflow
# Required with the profile: openssl rand -hex 16
# LOCAL_GIT_ADMIN_PASSWORD=
# LOCAL_GIT_ADMIN_EMAIL=
# Organization to create for repositories (defaults to the admin user).
# LOCAL_GIT_OWNER=
# Public URL that Agents and browsers use.
# LOCAL_GIT_URL=http://localhost:3300
# LOCAL_GIT_PORT=3300
# LOCAL_GIT_SERVER_URL=http://local-git:3000
# Defaults to LOCAL_GIT_URL.
# LOCAL_GIT_RUNNER_URL=
# Override only: normally the job writes the token to LOCAL_GIT_TOKEN_FILE.
# LOCAL_GIT_TOKEN=

# --- Orchestrator Agent (profile `orchestrator`, runtime) ------------------
# The Agent that runs orchestrated workflows' turns, in a container of this
# stack. After the first `up`: sign in, Settings → API Keys, create a key with
# the write scope, paste it here, then `up -d` with the profile. Then set the
# Agent's model provider under Agents and add it to the project.
# ORCHESTRATOR_AGENT_API_KEY=
# ORCHESTRATOR_AGENT_NAME=af-orch

# --- Mailpit (profile `mailpit`, runtime) ----------------------------------
# With the profile, set SMTP_URL=smtp://mailpit:1025 in the Mail section.
# MAILPIT_UI_USER=admin
# Required with the profile, no spaces: openssl rand -hex 16
# MAILPIT_UI_PASSWORD=
# MAILPIT_UI_PORT=8025
# MAILPIT_SMTP_PORT=1025

# --- Host ports (bound to 127.0.0.1) ---------------------------------------
# APP_PORT=3000
# API_PORT=3002
# MCP_PORT=3010
# S3_PORT=9000
# S3_CONSOLE_PORT=9001

# --- Optional integrations --------------------------------------------------
# runtime
# LIVEBLOCKS_SECRET=
# GITHUB_APP_ID=
# GITHUB_APP_PRIVATE_KEY=
# GITHUB_APP_WEBHOOK_SECRET=
# GITHUB_APP_CLIENT_ID=
# GITHUB_APP_CLIENT_SECRET=
# build-time (app)
# NEXT_PUBLIC_GITHUB_APP_SLUG=
# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=
# NEXT_PUBLIC_LOGO_URL=
