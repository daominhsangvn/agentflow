# AgentFlow production environment.
#
#   cp deploy/compose/.env.prod.example deploy/compose/.env
#
# Fill the values below. Comment out what you do not use: an empty value fails
# validation for some optional fields. The compose file sets these itself, do not
# set them here: DATABASE_URL, S3_ENDPOINT, BETTER_AUTH_URL, AGENTFLOW_MCP_URL,
# AUTH_API_URL.
#
# Marked "build-time": baked into an image, rebuild after changing
# (`up -d --build`). Marked "runtime": `up -d` recreates the containers.

# --- Public origins ---------------------------------------------------------
# build-time (app AND api)
NEXT_PUBLIC_APP_URL=https://agentflow.example.com
NEXT_PUBLIC_API_URL=https://api.agentflow.example.com
# Marketing/docs site, or the app origin if you have none.
NEXT_PUBLIC_WEB_URL=https://agentflow.example.com
# build-time (app)
# NEXT_PUBLIC_DOCS_URL=
# runtime
MCP_SERVER_URL=https://mcp.agentflow.example.com
# Browser-reachable S3 origin baked into presigned URLs.
S3_PUBLIC_ENDPOINT=https://s3.agentflow.example.com
# Defaults to the API origin.
# API_BASE_URL=
# PUBLIC_WEBHOOK_BASE_URL=

# --- Secrets (runtime) ------------------------------------------------------
# URL-safe, used inside DATABASE_URL: openssl rand -hex 32
POSTGRES_PASSWORD=
# S3 credentials for RustFS: openssl rand -hex 16 / openssl rand -hex 32
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# openssl rand -base64 32
BETTER_AUTH_SECRET=
# openssl rand -base64 32. Losing it makes stored tokens unreadable: back it up.
ENCRYPTION_KEY=
# openssl rand -hex 32
INTERNAL_API_SECRET=
# Required (the api refuses to start without it). At least 32 characters, at
# least 8 different ones: openssl rand -hex 32
AGENTFLOW_RUNNER_JWT_SECRET=

# --- Postgres / S3 (runtime) -----------------------------------------------
# POSTGRES_USER=postgres
# POSTGRES_DB=agentflow_ai
S3_REGION=us-east-1
FILE_ATTACHMENTS_BUCKET=agentflow-attachments
TRANSCRIPTS_BUCKET=agentflow-transcripts
PLUGIN_STORE_BUCKET=agentflow-plugin-store
LOOP_STATE_BUCKET=agentflow-loop-state
# Defaults to NEXT_PUBLIC_APP_URL.
# S3_CORS_ALLOWED_ORIGINS=

# --- Mail (runtime) ---------------------------------------------------------
SMTP_URL=smtp://user:pass@mail.example.com:587
EMAIL_FROM="AgentFlow <no-reply@example.com>"

# --- Authentication (runtime) ----------------------------------------------
# AUTH_ALLOW_SIGN_UP=false
# AUTH_AUTO_JOIN_DEFAULT_ORGANIZATION=false
# AUTH_ALLOW_CREATE_ORGANIZATION=true
# AUTH_DEFAULT_ORGANIZATION_NAME=AgentFlow
# AUTH_DEFAULT_ORGANIZATION_SLUG=agentflow
# Extra origins, comma-separated.
# BETTER_AUTH_TRUSTED_ORIGINS=

# --- Feature flags ----------------------------------------------------------
# runtime (api)
# AGENTFLOW_FEATURE_FLAGS=
# build-time (app)
# NEXT_PUBLIC_AGENTFLOW_FEATURE_FLAGS=

# --- Scheduler (runtime) ----------------------------------------------------
# WORKFLOW_TICK_SECONDS=10
# WORKFLOW_RUN_PHASE_TIMEOUT_HOURS=24
# SELF_HOSTED_CRON_DISABLED=true
# CRON_SECRET=

# --- Local Git (profile `local-git`, runtime) ------------------------------
# LOCAL_GIT_URL=http://localhost:3300
# LOCAL_GIT_PORT=3300
# LOCAL_GIT_SERVER_URL=http://local-git:3000
# LOCAL_GIT_RUNNER_URL=
# LOCAL_GIT_TOKEN=
# LOCAL_GIT_OWNER=

# --- Host ports (bound to 127.0.0.1) ---------------------------------------
# APP_PORT=3000
# API_PORT=3002
# MCP_PORT=3010
# S3_PORT=9000
# S3_CONSOLE_PORT=9001

# --- Optional integrations --------------------------------------------------
# runtime
# LIVEBLOCKS_SECRET=
# GITHUB_APP_ID=
# GITHUB_APP_PRIVATE_KEY=
# GITHUB_APP_WEBHOOK_SECRET=
# GITHUB_APP_CLIENT_ID=
# GITHUB_APP_CLIENT_SECRET=
# build-time (app)
# NEXT_PUBLIC_GITHUB_APP_SLUG=
# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=
# NEXT_PUBLIC_LOGO_URL=
