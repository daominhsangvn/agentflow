    {
      "id": "97c5fdd8-ec36-4912-abcf-56390dd409de",
      "panelTypes": "graph",
      "title": "orchestrator spans by name",
      "description": "",
      "opacity": "1",
      "nullZeroValues": "zero",
      "timePreferance": "GLOBAL_TIME",
      "softMin": null,
      "softMax": null,
      "selectedLogFields": null,
      "selectedTracesFields": null,
      "yAxisUnit": "none",
      "query": {
        "queryType": "clickhouse_sql",
        "id": "d2272cdb-bc55-4fb1-ae55-d3d56e126727",
        "clickhouse_sql": [
          {
            "name": "A",
            "legend": "{{label}}",
            "disabled": false,
            "query": "SELECT toStartOfInterval(timestamp, INTERVAL 1 MINUTE) AS ts, name AS label, count() AS value FROM signoz_traces.distributed_signoz_index_v3 WHERE name LIKE 'orchestrator.%' AND timestamp BETWEEN {{.start_datetime}} AND {{.end_datetime}} AND ts_bucket_start BETWEEN {{.start_timestamp}} - 1800 AND {{.end_timestamp}} GROUP BY ts, label ORDER BY ts"
          }
        ],
        "promql": [
          {
            "name": "A",
            "query": "",
            "legend": "",
            "disabled": false
          }
        ],
