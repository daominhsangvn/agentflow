            "query": "SELECT toStartOfInterval(timestamp, INTERVAL 1 MINUTE) AS ts, name AS label, 100 * countIf(has_error) / count() AS value FROM signoz_traces.distributed_signoz_index_v3 WHERE name LIKE 'orchestrator.%' AND timestamp BETWEEN {{.start_datetime}} AND {{.end_datetime}} AND ts_bucket_start BETWEEN {{.start_timestamp}} - 1800 AND {{.end_timestamp}} GROUP BY ts, label ORDER BY ts"
